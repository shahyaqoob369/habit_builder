rules_version = '2';

// Monumental Habits: every user reads and writes only their own data.
// Everything not matched below is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // users/{uid}: the profile written at sign up (name, email, marketing
    // consent). Other fields are rejected.
    match /users/{uid} {
      allow read, delete: if signedInAs(uid);
      allow create: if signedInAs(uid)
        && request.resource.data.keys().hasOnly(
             ['name', 'email', 'marketingOptIn', 'createdAt'])
        && validProfile(request.resource.data)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time;
      allow update: if signedInAs(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
             ['name', 'marketingOptIn', 'updatedAt'])
        && validProfile(request.resource.data)
        && request.resource.data.updatedAt == request.time;
    }

    // users/{uid}/habits/{habitId}: see HabitMapper for the fields.
    match /users/{uid}/habits/{habitId} {
      allow read, delete: if signedInAs(uid);
      allow create: if signedInAs(uid)
        && validHabit(request.resource.data)
        && request.resource.data.sortKey is int;
      allow update: if signedInAs(uid)
        && validHabit(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.sortKey == resource.data.sortKey;
    }

    // users/{uid}/feedback/{id}: messages from Settings → Feedback.
    match /users/{uid}/feedback/{feedbackId} {
      allow read, delete: if signedInAs(uid);
      allow create: if signedInAs(uid)
        && request.resource.data.keys().hasOnly(
             ['message', 'createdAt', 'platform', 'appVersion'])
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 1000
        && request.resource.data.createdAt == request.time
        && request.resource.data.platform is string
        && request.resource.data.platform.size() <= 20
        && request.resource.data.appVersion is string
        && request.resource.data.appVersion.size() <= 40;
    }

    function validHabit(data) {
      return data.keys().hasOnly(['name', 'color', 'icon', 'createdAt',
             'sortKey', 'weekdays', 'reminders', 'notificationsEnabled',
             'log', 'easiness'])
        && data.keys().hasAll(['name', 'color', 'icon', 'createdAt',
             'sortKey', 'weekdays'])
        && data.name is string && data.name.size() > 0
        && data.name.size() <= 100
        && data.color is string && data.color.size() <= 20
        && data.icon is string && data.icon.size() <= 20
        && data.createdAt is string && data.createdAt.size() == 10
        && data.weekdays is list && data.weekdays.size() > 0
        && data.weekdays.size() <= 7
        && (!('reminders' in data)
            || (data.reminders is list && data.reminders.size() <= 48))
        && (!('notificationsEnabled' in data)
            || data.notificationsEnabled is bool)
        && (!('log' in data) || data.log is map)
        && (!('easiness' in data) || data.easiness is map);
    }

    function signedIn() {
      return request.auth != null;
    }

    function validText(text, max) {
      return text is string && text.size() > 0 && text.size() <= max;
    }

    function validName(name) {
      return name is string && name.size() <= 100;
    }

    // users/{uid}/blocked/{memberId}: members this user hid.
    match /users/{uid}/blocked/{memberId} {
      allow read, delete: if signedInAs(uid);
      allow create: if signedInAs(uid)
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time;
    }

    // Community (see FirestoreCommunityRepository). Signed-in users read
    // everything. Without Cloud Functions, a like or comment moves its
    // post's counter by exactly one in the same batch, checked here both
    // ways (the counter and the like or comment).
    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['authorId', 'authorName',
             'text', 'createdAt', 'likeCount', 'commentCount'])
        && request.resource.data.authorId == request.auth.uid
        && validName(request.resource.data.authorName)
        && validText(request.resource.data.text, 1000)
        && request.resource.data.createdAt == request.time
        && request.resource.data.likeCount == 0
        && request.resource.data.commentCount == 0;
      allow delete: if signedInAs(resource.data.authorId);
      allow update: if signedIn()
        && (likeChanged() || commentAdded() || commentRemoved());

      function changed() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      function myLike() {
        return /databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid);
      }

      function comment(id) {
        return /databases/$(database)/documents/posts/$(postId)/comments/$(id);
      }

      function likeChanged() {
        return changed().hasOnly(['likeCount'])
          && ((request.resource.data.likeCount == resource.data.likeCount + 1
               && !exists(myLike()) && existsAfter(myLike()))
            || (request.resource.data.likeCount == resource.data.likeCount - 1
               && exists(myLike()) && !existsAfter(myLike())));
      }

      function commentAdded() {
        return changed().hasOnly(['commentCount', 'lastCommentId'])
          && request.resource.data.commentCount
             == resource.data.commentCount + 1
          && !exists(comment(request.resource.data.lastCommentId))
          && existsAfter(comment(request.resource.data.lastCommentId));
      }

      function commentRemoved() {
        return changed().hasOnly(['commentCount', 'lastRemovedCommentId'])
          && request.resource.data.commentCount
             == resource.data.commentCount - 1
          && exists(comment(request.resource.data.lastRemovedCommentId))
          && !existsAfter(comment(request.resource.data.lastRemovedCommentId));
      }

      function post() {
        return /databases/$(database)/documents/posts/$(postId);
      }

      function postAuthor() {
        return get(post()).data.authorId == request.auth.uid;
      }

      match /likes/{likeUid} {
        allow read: if signedIn();
        allow create: if signedInAs(likeUid)
          && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
          && request.resource.data.uid == likeUid
          && request.resource.data.createdAt == request.time
          && getAfter(post()).data.likeCount
             == get(post()).data.likeCount + 1;
        allow delete: if (signedInAs(likeUid)
            && getAfter(post()).data.likeCount
               == get(post()).data.likeCount - 1)
          || postAuthor();
      }

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['authorId', 'authorName',
               'text', 'createdAt'])
          && request.resource.data.authorId == request.auth.uid
          && validName(request.resource.data.authorName)
          && validText(request.resource.data.text, 500)
          && request.resource.data.createdAt == request.time
          && getAfter(post()).data.lastCommentId == commentId;
        allow delete: if (signedInAs(resource.data.authorId)
            && getAfter(post()).data.lastRemovedCommentId == commentId)
          || postAuthor();
      }
    }

    // Collection group queries: my likes (feed hearts) and, when deleting
    // an account, my comments.
    match /{path=**}/likes/{likeUid} {
      allow read: if signedIn();
    }

    match /{path=**}/comments/{commentId} {
      allow read: if signedIn();
    }

    // Reports for moderators, read in the Firebase console only.
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['postId', 'reporterId',
             'createdAt'])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.postId.size() <= 100
        && request.resource.data.createdAt == request.time;
    }

    function validProfile(data) {
      return data.name is string && data.name.size() <= 100
        && (!('marketingOptIn' in data) || data.marketingOptIn is bool);
    }
  }
}
